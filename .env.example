# ── LLM Configuration ─────────────────────────────────────
# Set USE_LOCAL_LLM=True to use deterministic Python agent (no API key needed)
# Set USE_LOCAL_LLM=False to use OpenAI GPT-3.5 for explanations
USE_LOCAL_LLM=True
OPENAI_API_KEY=your_openai_api_key_here

# ── MongoDB Configuration ──────────────────────────────────
MONGO_URI=mongodb://localhost:27017
MONGODB_DB_NAME=loan_agent_db

# ── Risk Thresholds ────────────────────────────────────────
# Applications with risk < APPROVE threshold → Approved
# Applications with risk > REJECT threshold → Rejected
# In between → Manual Review
THRESHOLD_APPROVE=0.4
THRESHOLD_REJECT=0.7

# ── Plaid Configuration (Optional) ────────────────────────
# Get credentials from https://dashboard.plaid.com
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_sandbox_secret
PLAID_ENV=sandbox

# ── Credit Bureau Mock API ─────────────────────────────────
# Built-in mock is used by default (no external service needed)
# Only set these if you have an actual external bureau API
CREDIT_BUREAU_API_URL=http://localhost:8001
CREDIT_BUREAU_API_KEY=mock_api_key_12345

# ── File Upload Settings ───────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760
